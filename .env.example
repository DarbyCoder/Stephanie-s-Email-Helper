# Copy to .env.local (local dev) and add the same values in Vercel -> Settings -> Environment Variables.

# Supabase project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase publishable key (sb_publishable_...) or legacy anon key. Server-only, never sent to the browser.
SUPABASE_PUBLISHABLE_KEY=

# Optional. Identifies this app to OpenStreetMap Nominatim (their usage policy asks for a
# User-Agent naming the app, ideally with a contact URL or email).
# NOMINATIM_USER_AGENT="StartupBoston-VolunteerHub/1.0 (https://your-site.vercel.app)"

# Optional. If set, /api/keepalive only answers requests carrying it (Vercel Cron sends it automatically).
# CRON_SECRET=
